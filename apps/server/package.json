{
  "name": "@inferno/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && NODE_ENV=development node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@inferno/shared": "workspace:*",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@inferno/tools": "workspace:*",
    "@types/ws": "^8.18.2"
  }
}
